# --- ROM Header Configuration (MUST BE AT THE TOP) ---
# These variables must be set before including n64.mk
TARGET          = Raptor-N64

# Build paths
BUILD_DIR       = build-n64
SOURCE_DIR      = .
N64_MKDFS_ROOT  = data

# --- SDL2 Configuration ---
SDL2_ROOT_DIR   = SDL2_ReallyUnstable
SDL2_BPP        = DEPTH_32_BPP

# Include the SDL2 logic first
include $(SDL2_ROOT_DIR)/Makefile_sdl2.mk

# --- Source Discovery ---
SRC_DIRS        = src .
CFILES          := $(foreach d,$(SRC_DIRS),$(wildcard $(d)/*.c))
CPPFILES        := $(foreach d,$(SRC_DIRS),$(wildcard $(d)/*.cpp))
SRCS            := $(CFILES) $(CPPFILES) $(C_SDL_FILES)
OBJS            := $(SRCS:%.c=$(BUILD_DIR)/%.o)
OBJS            := $(OBJS:%.cpp=$(BUILD_DIR)/%.o)

# --- Include Paths ---
# Added $(SDL2_ROOT_DIR)/include to fix the SDL_config.h error
INC_DIRS        = ./ src $(SDL2_ROOT_DIR)/include include/textscreen/include include/TimGM6mb include/TinySoundFont

CUSTOM_FLAGS    = $(foreach d,$(INC_DIRS),-I$(CURDIR)/$(d)) \
                  -Os -ffast-math -D__MIPS__ -D__N64__ -D__PPC__ \
                  -Wno-error=missing-braces -Wno-error=strict-aliasing \
                  -Wno-error=incompatible-pointer-types -Wno-error=char-subscripts \
                  -Wno-error=maybe-uninitialized -Wno-error=format-overflow \
                  -Wno-error=misleading-indentation -Wno-error=sign-compare \
                  -Wno-error=class-memaccess -Wno-error=uninitialized \
                  -Wno-error=format= -Wno-error=use-after-free

# --- Libdragon Build System ---
include $(N64_INST)/include/n64.mk

N64_ROM_TITLE   = "Raptor N64"
N64_ROM_SAVETYPE = eeprom16k    # Vital for Everdrive V3 to know how to save
# N64_ROM_REGION  = E            # E=USA, P=PAL, J=Japan
N64_ROM_REGIONFREE = true
# N64_ROM_RTC     = false

# Append flags after n64.mk to ensure N64_CFLAGS is already initialized
N64_CFLAGS      += $(CUSTOM_FLAGS)
N64_CXXFLAGS    += $(CUSTOM_FLAGS) -fno-rtti -fno-exceptions
# N64_LDFLAGS     += -flto

# --- Rules ---
default: $(TARGET).z64

# Note: We do NOT define a recipe for $(TARGET).z64 here. 
# We let the pattern rule in n64.mk handle the n64tool and ed64romconfig calls.
$(TARGET).z64: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).dfs

$(BUILD_DIR)/$(TARGET).elf: $(OBJS)

$(BUILD_DIR)/$(TARGET).dfs: $(wildcard data/*)

clean:
	rm -rf $(BUILD_DIR) $(TARGET).z64

.PHONY: default clean